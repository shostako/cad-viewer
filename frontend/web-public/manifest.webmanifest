{
  "name": "cad-viewer（Web 版）",
  "short_name": "cad-viewer",
  "description": "STEP・IGES・STL・DXF などを、ブラウザの中だけで開いて測る CAD ビューア。ファイルはどこにも送らない",
  "lang": "ja",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1d2126",
  "theme_color": "#1d2126",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "model/step": [".step", ".stp"],
        "model/iges": [".igs", ".iges"],
        "model/stl": [".stl"],
        "model/obj": [".obj"],
        "model/3mf": [".3mf"],
        "image/vnd.dxf": [".dxf"],
        "application/octet-stream": [".ply", ".off"]
      }
    }
  ]
}
